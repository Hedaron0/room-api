GET http://localhost:8080/api/rooms/abc

### ---------- Week 10: HTTP Basic ----------

### 42. POST room, no login (expect 401, "login required")
POST http://localhost:8080/api/rooms
Content-Type: application/json

{ "name": "Lab 42", "capacity": 6 }

### 43. Sign up lee (expect 201, id + username + role, no password)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{ "username": "lee", "password": "lee12345" }

### 44. Sign up lee again (expect 409, "username lee is taken")
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{ "username": "lee", "password": "lee12345" }

### 45. Bad username and short password (expect 400, two fieldErrors)
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{ "username": "Lee!", "password": "short" }

### 46. POST room as lee (expect 201 + Location: /api/rooms/5)
POST http://localhost:8080/api/rooms
Content-Type: application/json
Authorization: Basic bGVlOmxlZTEyMzQ1

{ "name": "Lee Lab", "capacity": 6 }

### 47. POST room, wrong password (expect 401, "wrong username or password")
POST http://localhost:8080/api/rooms
Content-Type: application/json
Authorization: Basic bGVlOndyb25ncGFzcw==

{ "name": "Nope", "capacity": 6 }

### 48. GET rooms, no login (expect 200, 4 rooms)
GET http://localhost:8080/api/rooms

### 49. Who am I, as lee with Basic (expect 200, lee, ROLE_USER)
GET http://localhost:8080/api/auth/me
Authorization: Basic bGVlOmxlZTEyMzQ1

### ---------- Week 10: tokens ----------

### 50. Log in (expect 200, accessToken)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{ "username": "lee", "password": "lee12345" }

> {% client.global.set("token", response.body.accessToken); %}

### 51. Log in, wrong password (expect 401, "wrong username or password")
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{ "username": "lee", "password": "wrongpass" }

### 52. Who am I, with the token (expect 200, lee, no ROLE_USER yet)
GET http://localhost:8080/api/auth/me
Authorization: Bearer {{token}}

### 53. POST room with the token (expect 201 + Location: /api/rooms/6)
POST http://localhost:8080/api/rooms
Content-Type: application/json
Authorization: Bearer {{token}}

{ "name": "Token Lab", "capacity": 8 }

### 54. POST room, broken token (expect 401, "token is invalid or expired")
POST http://localhost:8080/api/rooms
Content-Type: application/json
Authorization: Bearer {{token}}x

{ "name": "Broken", "capacity": 8 }

### 55. GET rooms, broken token (expect 401, a sent token is always checked)
GET http://localhost:8080/api/rooms
Authorization: Bearer {{token}}x

### 56. Reservations without login (expect 401, "login required")
GET http://localhost:8080/api/reservations?reservedBy=Mina

